# --- Server ---
PORT=3001
NODE_ENV=development

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ecom
DB_PASSWORD=ecom
DB_NAME=ecom_research

# --- Redis (background job queue for data ingestion) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Config file overrides (defaults point at the repo-root /config folder) ---
SCORING_CONFIG_PATH=../config/scoring-weights.json
CATEGORIES_CONFIG_PATH=../config/categories.json

# --- Keepa (first real data source, amazon.in = domain 10) ---
# Leave BLANK to stay in dry-run mode: with no key the adapter makes no network requests
# and reports KEEPA_NOT_CONFIGURED. Setting it does not by itself enable collection —
# you must also set enabled=true for the keepa entry in config/data-sources.json.
KEEPA_API_KEY=

# Pilot batch size. Default 10, hard-capped at 100 in pilot mode.
MAX_PRODUCTS=10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
